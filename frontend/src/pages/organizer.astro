---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Panel organizador | MendoCultura">
  <section>
    <div class="section-heading">
      <div>
        <div class="eyebrow">Organizador</div>
        <h1>Panel de organizador</h1>
        <p class="lead">Creá eventos con información completa, imágenes, ubicación y datos útiles para asistentes.</p>
      </div>
    </div>
    <div id="sessionNotice" aria-live="polite"></div>

    <div class="form-card" id="eventForm">
      <div class="section-heading" style="margin-top:0;">
        <div>
          <h2 id="formTitle">Crear evento</h2>
          <p>Los datos se muestran en el catálogo y en el detalle del evento.</p>
        </div>
        <button id="resetFormButton" class="secondary" type="button">Nuevo evento</button>
      </div>
      <div class="form-grid">
        <label>Título <input id="title" /></label>
        <label>Categoría <select id="category"></select></label>
        <label class="full">Descripción corta <textarea id="description"></textarea></label>
        <label class="full">Descripción completa <textarea id="extendedDescription"></textarea></label>
        <label>Departamento <select id="department"></select></label>
        <label>Venue <input id="venue" /></label>
        <label class="full">Dirección <input id="address" /></label>
        <label class="full">Imagen principal <input id="imageUrl" placeholder="https://..." /></label>
        <label class="full">Galería de imágenes <textarea id="galleryImages" placeholder="URLs separadas por coma"></textarea></label>
        <label class="full">Mapa iframe o URL opcional <input id="mapUrl" placeholder="Opcional: se genera con dirección si queda vacío" /></label>
        <label>Fecha <input id="startAt" type="datetime-local" /></label>
        <label>Tipo de entrada <input id="ticketType" value="General" /></label>
        <label>Precio en centavos <input id="priceCents" type="number" value="100000" min="0" /></label>
        <label>Cupo <input id="capacity" type="number" value="50" min="1" /></label>
        <label class="full">Información importante <textarea id="importantInfo"></textarea></label>
        <label class="full">Recomendaciones <textarea id="recommendations"></textarea></label>
        <label>Estado
          <select id="status">
            <option value="DRAFT">Borrador</option>
            <option value="PUBLISHED">Publicado</option>
            <option value="PAUSED">Pausado</option>
            <option value="CANCELLED">Cancelado</option>
            <option value="FINISHED">Finalizado</option>
          </select>
        </label>
      </div>
      <div class="actions">
        <button id="saveButton">Crear evento</button>
      </div>
      <div id="saveResult" style="margin-top:16px;" aria-live="polite"></div>
    </div>

    <div class="actions">
      <button id="loadEventsButton" class="secondary">Ver eventos propios</button>
      <button id="loadReportsButton" class="secondary">Ver estadísticas</button>
    </div>
    <div id="panelData" class="grid" style="margin-top:24px;" aria-live="polite"></div>
  </section>

  <script>
    const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080/api/v1';
    const token = localStorage.getItem('mendocultura_token');
    const user = JSON.parse(localStorage.getItem('mendocultura_user') || 'null');
    const panelData = document.querySelector('#panelData');
    const sessionNotice = document.querySelector('#sessionNotice');
    const saveResult = document.querySelector('#saveResult');
    const saveButton = document.querySelector('#saveButton');
    const formTitle = document.querySelector('#formTitle');
    let editingEventId = null;

    const categories = ['Vendimia', 'Bodegas', 'Recitales', 'Festivales', 'Teatro', 'Deportes', 'Gastronomía', 'Universitarios', 'Congresos', 'Exposiciones', 'Fiestas', 'Música', 'Turismo', 'Cultura', 'Arte', 'Cine', 'Danza', 'Infantil', 'Charlas', 'Ferias', 'Otros'];
    const departments = ['Ciudad de Mendoza', 'Godoy Cruz', 'Guaymallén', 'Las Heras', 'Lavalle', 'Luján de Cuyo', 'Maipú', 'Junín', 'Rivadavia', 'San Martín', 'Santa Rosa', 'La Paz', 'Tunuyán', 'Tupungato', 'San Carlos', 'San Rafael', 'General Alvear', 'Malargüe'];
    document.querySelector('#category').innerHTML = categories.map((item) => `<option value="${item}">${item}</option>`).join('');
    document.querySelector('#department').innerHTML = departments.map((item) => `<option value="${item}">${item}</option>`).join('');

    const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
    document.querySelector('#startAt').value = tomorrow.toISOString().slice(0, 16);

    function escapeHtml(value = '') {
      return String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char]);
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
    }

    function showSaveMessage(type, message) {
      saveResult.innerHTML = `<p class="notice ${type}">${message}</p>`;
    }

    function showPanelMessage(type, message) {
      panelData.innerHTML = `<p class="notice ${type}">${message}</p>`;
    }

    async function readJson(response) {
      try {
        return await response.json();
      } catch {
        return {};
      }
    }

    function hasOrganizerAccess() {
      if (!token) {
        sessionNotice.innerHTML = '<p class="notice error">Tenés que iniciar sesión como organizador o administrador. <a href="/login">Iniciar sesión</a></p>';
        return false;
      }
      if (!['ORGANIZER', 'ADMIN'].includes(user?.role)) {
        sessionNotice.innerHTML = '<p class="notice error">Tu usuario no tiene permisos para gestionar eventos.</p>';
        return false;
      }
      sessionNotice.innerHTML = `<p class="notice success">Sesión activa como ${user.role}. Si el organizador no está aprobado, el backend bloqueará las acciones.</p>`;
      return true;
    }

    function payloadFromForm() {
      const rawDate = document.querySelector('#startAt').value;
      const startDate = new Date(rawDate);
      if (!rawDate || Number.isNaN(startDate.getTime())) return null;
      return {
        title: document.querySelector('#title').value.trim(),
        description: document.querySelector('#description').value.trim(),
        extendedDescription: document.querySelector('#extendedDescription').value.trim(),
        category: document.querySelector('#category').value,
        department: document.querySelector('#department').value,
        venue: document.querySelector('#venue').value.trim(),
        address: document.querySelector('#address').value.trim(),
        imageUrl: document.querySelector('#imageUrl').value.trim(),
        galleryImages: document.querySelector('#galleryImages').value.trim(),
        mapUrl: document.querySelector('#mapUrl').value.trim(),
        ticketType: document.querySelector('#ticketType').value.trim() || 'General',
        importantInfo: document.querySelector('#importantInfo').value.trim(),
        recommendations: document.querySelector('#recommendations').value.trim(),
        startAt: startDate.toISOString(),
        priceCents: Number(document.querySelector('#priceCents').value),
        capacity: Number(document.querySelector('#capacity').value),
        status: document.querySelector('#status').value
      };
    }

    function resetForm() {
      editingEventId = null;
      formTitle.textContent = 'Crear evento';
      saveButton.textContent = 'Crear evento';
      document.querySelectorAll('#eventForm input, #eventForm textarea').forEach((input) => {
        if (input.id !== 'priceCents' && input.id !== 'capacity' && input.id !== 'ticketType' && input.id !== 'startAt') input.value = '';
      });
      document.querySelector('#priceCents').value = '100000';
      document.querySelector('#capacity').value = '50';
      document.querySelector('#ticketType').value = 'General';
      document.querySelector('#startAt').value = tomorrow.toISOString().slice(0, 16);
      document.querySelector('#status').value = 'DRAFT';
      saveResult.innerHTML = '';
    }

    function fillForm(event) {
      editingEventId = event.id;
      formTitle.textContent = `Editar evento #${event.id}`;
      saveButton.textContent = 'Guardar cambios';
      ['title', 'description', 'extendedDescription', 'category', 'department', 'venue', 'address', 'imageUrl', 'galleryImages', 'mapUrl', 'ticketType', 'importantInfo', 'recommendations', 'status'].forEach((id) => {
        document.querySelector(`#${id}`).value = event[id] || (id === 'ticketType' ? 'General' : '');
      });
      document.querySelector('#priceCents').value = event.priceCents;
      document.querySelector('#capacity').value = event.capacity;
      document.querySelector('#startAt').value = new Date(event.startAt).toISOString().slice(0, 16);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function saveEvent() {
      if (!hasOrganizerAccess()) return;
      const payload = payloadFromForm();
      if (!payload) {
        showSaveMessage('error', 'Ingresá una fecha válida para el evento.');
        return;
      }
      if (!payload.title || !payload.category || !payload.department || !payload.venue || payload.capacity < 1 || payload.priceCents < 0) {
        showSaveMessage('error', 'Completá título, categoría, departamento, venue, precio y cupo válido.');
        return;
      }

      saveButton.disabled = true;
      showSaveMessage('', editingEventId ? 'Guardando cambios...' : 'Creando evento...');
      try {
        const response = await fetch(`${apiUrl}/organizer/events${editingEventId ? `/${editingEventId}` : ''}`, {
          method: editingEventId ? 'PUT' : 'POST',
          headers: authHeaders(),
          body: JSON.stringify(payload)
        });
        const data = await readJson(response);
        if (!response.ok) {
          showSaveMessage('error', data.message || 'No se pudo guardar el evento.');
          return;
        }
        showSaveMessage('success', editingEventId ? 'Evento actualizado correctamente.' : 'Evento creado correctamente.');
        await loadEvents();
      } catch {
        showSaveMessage('error', 'No se pudo conectar con el backend. Verificá que esté corriendo en http://localhost:8080.');
      } finally {
        saveButton.disabled = false;
      }
    }

    async function loadEvents() {
      if (!hasOrganizerAccess()) return;
      showPanelMessage('', 'Cargando eventos...');
      try {
        const response = await fetch(`${apiUrl}/organizer/events`, { headers: authHeaders() });
        const data = await readJson(response);
        if (!response.ok) {
          showPanelMessage('error', data.message || 'No se pudieron cargar tus eventos.');
          return;
        }
        panelData.innerHTML = (data.events || []).map((event) => {
          const sold = event.capacity - event.availableTickets;
          const percent = event.capacity > 0 ? Math.round((sold * 100) / event.capacity) : 0;
          return `
            <article class="card">
              <span class="badge ${event.status === 'PUBLISHED' ? 'success' : 'warning'}">${event.status}</span>
              <h3>${escapeHtml(event.title)}</h3>
              <p>${escapeHtml(event.department)} · ${escapeHtml(event.venue)}</p>
              <p>${event.availableTickets} cupos disponibles de ${event.capacity}</p>
              <div class="progress"><span style="width:${percent}%"></span></div>
              <div class="actions"><button class="secondary" data-edit-event="${event.id}">Editar</button></div>
            </article>
          `;
        }).join('') || '<div class="empty-state"><h2>Creá tu primer evento</h2><p>Todavía no tenés eventos cargados.</p></div>';
        document.querySelectorAll('[data-edit-event]').forEach((button) => {
          const event = data.events.find((item) => String(item.id) === button.dataset.editEvent);
          button.addEventListener('click', () => fillForm(event));
        });
      } catch {
        showPanelMessage('error', 'No se pudo conectar con el backend. Verificá que esté corriendo en http://localhost:8080.');
      }
    }

    async function loadReports() {
      if (!hasOrganizerAccess()) return;
      showPanelMessage('', 'Cargando estadísticas...');
      try {
        const response = await fetch(`${apiUrl}/organizer/reports`, { headers: authHeaders() });
        const data = await readJson(response);
        if (!response.ok) {
          showPanelMessage('error', data.message || 'No se pudieron cargar las estadísticas.');
          return;
        }
        panelData.innerHTML = (data.reports || []).map((report) => `
          <article class="card">
            <h3>${escapeHtml(report.title)}</h3>
            <p>Entradas vendidas: <strong>${report.soldTickets}</strong></p>
            <p>Cupos disponibles: <strong>${report.availableTickets}</strong></p>
            <p>Ingresos estimados: <strong>$${(report.estimatedIncome / 100).toLocaleString('es-AR')}</strong></p>
            <p>Ocupación: <strong>${report.occupancyPercent}%</strong></p>
            <div class="progress"><span style="width:${report.occupancyPercent}%"></span></div>
          </article>
        `).join('') || '<div class="empty-state"><h2>Sin estadísticas todavía</h2><p>Cuando vendas entradas, los reportes aparecerán acá.</p></div>';
      } catch {
        showPanelMessage('error', 'No se pudo conectar con el backend. Verificá que esté corriendo en http://localhost:8080.');
      }
    }

    hasOrganizerAccess();
    saveButton.addEventListener('click', saveEvent);
    document.querySelector('#resetFormButton').addEventListener('click', resetForm);
    document.querySelector('#loadEventsButton').addEventListener('click', loadEvents);
    document.querySelector('#loadReportsButton').addEventListener('click', loadReports);
    loadEvents();
  </script>
</BaseLayout>
